# ==============================================
# Lime Social Media — Server Environment Config
# ==============================================

# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URL=mongodb://127.0.0.1:27017/lime_social

# JWT Secret Key
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# Cloudinary Storage (Optional: if not set, local disk storage at /uploads is used automatically)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_SECRET_API_KEY=your_cloudinary_secret_key

# Nodemailer Email Configuration (Optional: if not set, OTP codes are logged to the dev console)
EMAIL=your_email@gmail.com
PASSWORD=your_gmail_app_password

# Client URL for CORS
CLIENT_URL=http://localhost:5173
