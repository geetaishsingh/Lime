# =====================================================
# C Lime — Backend Environment Configuration
# =====================================================

PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated additional browser origins allowed to use the API.
CLIENT_URLS=
# In production, set NODE_ENV=production and COOKIE_SECURE=true.

# MongoDB Connection String
# For Atlas, allow your server IP in Network Access and use the database user's credentials.
MONGO_URL=mongodb://127.0.0.1:27017/lime_social

# JWT Secret Key
JWT_SECRET_KEY=replace_with_a_long_random_secret_in_production

# Cloudinary Media Storage (Optional — falls back to local /uploads if not set)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_SECRET_API_KEY=your_cloudinary_secret_key

# Email (required for signup, sign-in, and password reset OTP delivery)
EMAIL=your_email@gmail.com
PASSWORD=your_gmail_app_password

# Public backend origin used by OAuth callbacks.
# Important: Google/GitHub require the callback URL to match exactly.
# For local development keep this as http://localhost:5000 and avoid trailing slashes.
BACKEND_URL=http://localhost:5000

# Leave unset for host-only cookies. Do not set this to a Render hostname or
# a public suffix. For separate production frontend/backend origins, both must
# use HTTPS and the frontend origin must be listed in CLIENT_URL or CLIENT_URLS.
# COOKIE_DOMAIN=

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Add this exact URL to Google Cloud Console > Authorized redirect URIs.
# Local example: http://localhost:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth Credentials (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Add this exact URL to GitHub OAuth app > Authorization callback URL.
# Local example: http://localhost:5000/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
