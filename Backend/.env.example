# =====================================================
# C Lime — Backend Environment Configuration
# =====================================================

PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# For Atlas, allow your server IP in Network Access and use the database user's credentials.
MONGO_URL=mongodb://127.0.0.1:27017/lime_social

# JWT Secret Key
JWT_SECRET_KEY=lime_jwt_secret_key_change_in_production

# Cloudinary Media Storage (Optional — falls back to local /uploads if not set)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_SECRET_API_KEY=your_cloudinary_secret_key

# Email (Nodemailer for OTP codes — falls back to dev console logs if not set)
EMAIL=your_email@gmail.com
PASSWORD=your_gmail_app_password

# Public backend origin used by OAuth callbacks.
# Important: Google/GitHub require the callback URL to match exactly.
# For local development keep this as http://localhost:5000 and avoid trailing slashes.
BACKEND_URL=http://localhost:5000

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Add this exact URL to Google Cloud Console > Authorized redirect URIs.
# Local example: http://localhost:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth Credentials (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Add this exact URL to GitHub OAuth app > Authorization callback URL.
# Local example: http://localhost:5000/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
